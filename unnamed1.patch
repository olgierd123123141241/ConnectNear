+    var tempVisibilityMode by remember { mutableStateOf(userSelection.visibilityMode) }
+    var tempInterval by remember { mutableStateOf(userSelection.locationUpdateInterval) }
+    var expandedIntervals by remember { mutableStateOf(false) }
+
+    // Opcje czasu GPS
+    val intervals = mapOf(
+        "30s" to 30000L,
+        "1m" to 60000L,
+        "5m" to 300000L,
+        "30m" to 1800000L,
+        "1h" to 3600000L
+    )
+    val intervalNames = intervals.entries.associate { (k, v) -> v to k }
+
+    // --- 1. POWIADOMIENIA ---
+    LaunchedEffect(userSelection.userId) {
+        if (userSelection.userId.isNotEmpty()) {
+            FirebaseService.listenForNotifications(userSelection.userId) { data ->
+                val type = data["type"] as? String ?: "message"
+                val senderName = data["senderName"] as? String ?: "Ktoś"
+                val text = data["text"] as? String ?: ""
+                val senderId = data["senderId"] as? String ?: ""
+
+                if (type == "friend_request") {
+                    requestSenderName = senderName
+                    requestSenderId = senderId
+                    showFriendRequestDialog = true
+                } else {
+                    scope.launch {
+                        snackbarHostState.showSnackbar("$senderName: $text", duration = SnackbarDuration.Short, withDismissAction = true)
+                    }
+                }
+            }
+        }
+    }
+
+    // --- 2. GPS LOGIKA (POPRAWIONA - JEDEN BLOK KODU) ---
+
+    // Sprawdzamy uprawnienia przy starcie
+    var hasPermission by remember {
+        mutableStateOf(
+            ContextCompat.checkSelfPermission(
+                context,
+                Manifest.permission.ACCESS_FINE_LOCATION
+            ) == PackageManager.PERMISSION_GRANTED
+        )
+    }
+
+    // Launcher do pytania o zgodę (tylko raz!)
+    val permissionLauncher = rememberLauncherForActivityResult(
+        contract = ActivityResultContracts.RequestMultiplePermissions(),
+        onResult = { permissions ->
+            hasPermission = permissions[Manifest.permission.ACCESS_FINE_LOCATION] == true ||
+                    permissions[Manifest.permission.ACCESS_COARSE_LOCATION] == true
+        }
+    )
+
+    // Uruchamiamy pytanie tylko jeśli nie mamy zgody
+    LaunchedEffect(Unit) {
+        if (!hasPermission) {
+            permissionLauncher.launch(
+                arrayOf(Manifest.permission.ACCESS_FINE_LOCATION, Manifest.permission.ACCESS_COARSE_LOCATION)
+            )
+        }
+    }
+
+    // Pętla GPS (reaguje na zmianę userSelection.locationUpdateInterval po zapisie ustawień)
+    LaunchedEffect(userSelection.locationUpdateInterval, hasPermission) {
+        if (hasPermission) {
+            while (isActive) {
+                try {
+                    fusedLocationClient.lastLocation.addOnSuccessListener { location ->
+                        if (location != null) {
+                            myLocation = LatLng(location.latitude, location.longitude)
+                            userSelection.location = GeoPoint(location.latitude, location.longitude)
+                            FirebaseService.saveCurrentUser(userSelection) { FirebaseService.findMatches(userSelection) { otherUsers = it } }
+                        } else {
+                            fusedLocationClient.getCurrentLocation(Priority.PRIORITY_HIGH_ACCURACY, null).addOnSuccessListener { l ->
+                                if (l != null) {
+                                    myLocation = LatLng(l.latitude, l.longitude)
+                                    userSelection.location = GeoPoint(l.latitude, l.longitude)
+                                    FirebaseService.saveCurrentUser(userSelection) { FirebaseService.findMatches(userSelection) { otherUsers = it } }
+                                }
+                            }
+                        }
+                    }
+                } catch (e: SecurityException) { }
+                delay(userSelection.locationUpdateInterval)
+            }
+        }
+    }
+
+    // --- 3. BUDOWANIE EKRANU ---
+    Box(modifier = Modifier.fillMaxSize()) {
+
+        // A. MAPA (z FourthStageComponents.kt)
+        FourthStageMap(
+            myLocation = myLocation,
+            otherUsers = otherUsers,
+            onMapClick = { selectedUser = null },
+            onUserMarkerClick = { selectedUser = it },
+            hasPermission = hasPermission,
+            onPermissionRequest = { permissionLauncher.launch(arrayOf(Manifest.permission.ACCESS_FINE_LOCATION)) }
+        )
+
+        // B. POWIADOMIENIA (SNACKBAR)
+        SnackbarHost(hostState = snackbarHostState, modifier = Modifier.align(Alignment.TopCenter).padding(top = 50.dp))
+
+        // C. PRZYCISK USTAWIEŃ (Zębatka)
+        FourthStageSettingsFab(onClick = {
+            // Pobieramy aktualne ustawienia do zmiennych tymczasowych przed otwarciem okna
+            tempVisibilityMode = userSelection.visibilityMode
+            tempInterval = userSelection.locationUpdateInterval
+            showSettingsDialog = true
+        })
+
+        // D. DOLNY PANEL STEROWANIA (z FourthStageControls.kt)
+        FourthStageControls(
+            selectedUser = selectedUser,
+            currentRefreshRate = userSelection.locationUpdateInterval, // Pokazuje aktualny czas
+            onChatClick = { selectedUser?.let { onChatClick(it.userId, it.name) } },
+            onSendRequestClick = {
+                selectedUser?.let {
+                    FirebaseService.sendFriendRequest(
+                        userSelection.userId, userSelection.name, it.userId,
+                        { Toast.makeText(context, "Wysłano!", Toast.LENGTH_SHORT).show() },
+                        { Toast.makeText(context, "Błąd", Toast.LENGTH_SHORT).show() })
+                }
+            },
+            onOtherProfileClick = { selectedUser?.let { onOtherUserProfileClick(it.userId) } },
+            onCloseUserClick = { selectedUser = null },
+            onExitClick = onBackClick,
+            onFriendsListClick = onFriendsListClick,
+            onMyProfileClick = onProfileClick
+        )
+
+        // E. OKNO DIALOGOWE ZAPROSZENIA
+        if (showFriendRequestDialog) {
+            FourthStageFriendRequestDialog(
+                senderName = requestSenderName,
+                onAccept = {
+                    FirebaseService.acceptFriendRequest(
+                        userSelection.userId,
+                        requestSenderId,
+                        requestSenderName
+                    ) {
+                        Toast.makeText(context, "Dodano!", Toast.LENGTH_SHORT).show()
+                        showFriendRequestDialog = false
+                    }
+                },
+                onReject = { showFriendRequestDialog = false }
+            )
+        }
+
+        // F. OKNO DIALOGOWE USTAWIEŃ (Publiczny/Znajomi + Czas GPS)
+        if (showSettingsDialog) {
+            FourthStageSettingsDialog(
+                tempVisibilityMode = tempVisibilityMode,
+                onVisibilityChange = { tempVisibilityMode = it },
+                tempInterval = tempInterval,
+                onIntervalChange = { tempInterval = it },
+                expandedIntervals = expandedIntervals,
+                onExpandedChange = { expandedIntervals = it },
+                intervalNames = intervalNames,
+                intervals = intervals,
+                onSave = {
+                    // ZAPISUJEMY ZMIANY DO MODELU I DO BAZY
+                    userSelection.visibilityMode = tempVisibilityMode
+                    userSelection.locationUpdateInterval = tempInterval
+
+                    FirebaseService.updateFullProfile(
+                        user = userSelection,
+                        onSuccess = {
+                            Toast.makeText(context, "Zapisano ustawienia!", Toast.LENGTH_SHORT)
+                                .show()
+                            showSettingsDialog = false
+                        },
+                        onError = {
+                            Toast.makeText(context, "Błąd zapisu", Toast.LENGTH_SHORT).show()
+                        }
+                    )
+                },
+                onCancel = { showSettingsDialog = false }
+            )
+        }
+    }
+}
