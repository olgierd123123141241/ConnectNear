+                    // --- 4. DIALOG USTAWIEŃ (Z LOKALIZACJĄ) ---
+                    @Composable
+                    fun FourthStageSettingsDialog(
+                        // NOWE: WŁĄCZANIE/WYŁĄCZANIE LOKALIZACJI
+                        isSharingLocation: Boolean,
+                        onSharingChange: (Boolean) -> Unit,
+
+                        // KATEGORIA
+                        tempCategory: String,
+                        onCategoryChange: (String) -> Unit,
+                        expandedCategory: Boolean,
+                        onExpandedCategoryChange: (Boolean) -> Unit,
+
+                        // WIDOCZNOŚĆ
+                        tempVisibilityMode: String,
+                        onVisibilityChange: (String) -> Unit,
+
+                        // CZAS GPS
+                        tempInterval: Long,
+                        onIntervalChange: (Long) -> Unit,
+                        expandedIntervals: Boolean,
+                        onExpandedChange: (Boolean) -> Unit,
+                        intervalNames: Map<Long, String>,
+                        intervals: Map<String, Long>,
+
+                        // PROMIEŃ
+                        tempRadius: Double,
+                        onRadiusChange: (Double) -> Unit,
+                        expandedRadius: Boolean,
+                        onExpandedRadiusChange: (Boolean) -> Unit,
+                        radiuses: List<Double>,
+
+                        onClose: () -> Unit
+                    ) {
+                        val categories = listOf("Impreza", "Sport", "Podwójne randki", "Kawa", "Spacer", "Wspólna gra")
+
+                        AlertDialog(
+                            onDismissRequest = onClose,
+                            title = { Text("Szybkie Ustawienia") },
+                            text = {
+                                Column {
+                                    // --- PRZEŁĄCZNIK: WIDOCZNOŚĆ NA MAPIE ---
+                                    Row(
+                                        modifier = Modifier.fillMaxWidth(),
+                                        verticalAlignment = Alignment.CenterVertically,
+                                        horizontalArrangement = Arrangement.SpaceBetween
+                                    ) {
+                                        Text("Udostępniaj lokalizację:", fontWeight = FontWeight.Bold)
+                                        Switch(
+                                            checked = isSharingLocation,
+                                            onCheckedChange = {
+                                                onSharingChange(it) // Auto-zapis
+                                            }
+                                        )
+                                    }
+                                    Text(
+                                        text = if(isSharingLocation) "Jesteś widoczny na mapie" else "Jesteś niewidoczny (Tryb Ducha)",
+                                        fontSize = 12.sp,
+                                        color = if(isSharingLocation) Color(0xFF006400) else Color.Red
+                                    )
+
+                                    Divider(modifier = Modifier.padding(vertical = 12.dp))
+
+                                    // --- KATEGORIA ---
+                                    Text("Moja Kategoria:", fontWeight = FontWeight.Bold)
+                                    Box(modifier = Modifier.fillMaxWidth().padding(vertical = 8.dp)) {
+                                        Button(
+                                            onClick = { onExpandedCategoryChange(true) },
+                                            colors = ButtonDefaults.buttonColors(containerColor = Color(0xFF0AA4F4)),
+                                            modifier = Modifier.fillMaxWidth(),
+                                            enabled = isSharingLocation // Blokujemy zmianę jak wyłączone
+                                        ) {
+                                            Text(
+                                                text = if (tempCategory.isEmpty()) "Wybierz kategorię" else tempCategory,
+                                                color = Color.White
+                                            )
+                                        }
+                                        DropdownMenu(
+                                            expanded = expandedCategory,
+                                            onDismissRequest = { onExpandedCategoryChange(false) }
+                                        ) {
+                                            categories.forEach { cat ->
+                                                DropdownMenuItem(
+                                                    text = { Text(cat) },
+                                                    onClick = {
+                                                        onCategoryChange(cat)
+                                                        onExpandedCategoryChange(false)
+                                                    }
+                                                )
+                                            }
+                                            DropdownMenuItem(
+                                                text = { Text("Bez kategorii") },
+                                                onClick = { onCategoryChange(""); onExpandedCategoryChange(false) }
+                                            )
+                                        }
+                                    }
+
+                                    // --- WIDOCZNOŚĆ ---
+                                    Text("Kto może mnie widzieć?", fontWeight = FontWeight.Bold)
+                                    Row(verticalAlignment = Alignment.CenterVertically) {
+                                        RadioButton(selected = tempVisibilityMode == "public", onClick = { onVisibilityChange("public") }, enabled = isSharingLocation)
+                                        Text("Wszyscy", modifier = Modifier.clickable { if(isSharingLocation) onVisibilityChange("public") }, color = if(isSharingLocation) Color.Black else Color.Gray)
+
+                                        Spacer(modifier = Modifier.width(10.dp))
+
+                                        RadioButton(selected = tempVisibilityMode == "friends", onClick = { onVisibilityChange("friends") }, enabled = isSharingLocation)
+                                        Text("Znajomi", modifier = Modifier.clickable { if(isSharingLocation) onVisibilityChange("friends") }, color = if(isSharingLocation) Color.Black else Color.Gray)
+                                    }
+
+                                    Spacer(modifier = Modifier.height(8.dp))
+
+                                    // --- PROMIEŃ ---
+                                    Text("Promień wyszukiwania:", fontWeight = FontWeight.Bold)
+                                    Box {
+                                        Button(onClick = { onExpandedRadiusChange(true) }, colors = ButtonDefaults.buttonColors(containerColor = Color.LightGray)) {
+                                            Text("${tempRadius.toInt()} km", color = Color.Black)
+                                        }
+                                        DropdownMenu(expanded = expandedRadius, onDismissRequest = { onExpandedRadiusChange(false) }) {
+                                            radiuses.forEach { radius ->
+                                                DropdownMenuItem(
+                                                    text = { Text("${radius.toInt()} km") },
+                                                    onClick = { onRadiusChange(radius); onExpandedRadiusChange(false) }
+                                                )
+                                            }
+                                        }
+                                    }
+
+                                    Spacer(modifier = Modifier.height(8.dp))
+
+                                    // --- CZAS GPS ---
+                                    Text("Odświeżanie GPS:", fontWeight = FontWeight.Bold)
+                                    Box {
+                                        Button(onClick = { onExpandedChange(true) }, colors = ButtonDefaults.buttonColors(containerColor = Color.LightGray), enabled = isSharingLocation) {
+                                            Text(intervalNames[tempInterval] ?: "Wybierz", color = if(isSharingLocation) Color.Black else Color.Gray)
+                                        }
+                                        DropdownMenu(expanded = expandedIntervals, onDismissRequest = { onExpandedChange(false) }) {
+                                            intervals.forEach { (l, v) ->
+                                                DropdownMenuItem(text = { Text(l) }, onClick = { onIntervalChange(v); onExpandedChange(false) })
+                                            }
+                                        }
+                                    }
+                                }
+                            },
+                            confirmButton = {
+                                Button(onClick = onClose) { Text("Zamknij") }
+                            }
+                        )
+                    }
+
