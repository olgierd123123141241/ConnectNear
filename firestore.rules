rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth.uid == userId;

      match /friend_requests/{senderId} {
        allow create: if request.auth != null;
        allow delete: if request.auth.uid == userId;
      }
      
      match /notifications/{notificationId} {
          // Użytkownik może czytać własne powiadomienia i każdy może je do niego wysyłać.
          allow read, delete: if request.auth.uid == userId;
          allow create: if request.auth != null;
      }

      match /friends/{friendId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Dodajemy reguły dla kolekcji czatów
    match /chats/{chatId} {
      // Każdy członek czatu może czytać i pisać wiadomości
      // (Bardziej szczegółowe reguły można dodać później)
      allow read, write: if request.auth != null;
    }

    match /flash_events/{eventId} {
        allow read, write: if request.auth != null;
    }
  }
}
